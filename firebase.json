{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "indexes": [
      {
        "collectionGroup": "sugerencias",
        "queryScope": "COLLECTION",
        "fields": [
          { "fieldPath": "approved", "order": "ASCENDING" },
          { "fieldPath": "timestamp", "order": "ASCENDING" }
        ]
      }
    ]
  }
}
